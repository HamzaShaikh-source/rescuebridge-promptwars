[TEMPLATE]
# === RescueBridge Environment Variables ===
# Copy to .env and fill in real values. Never commit .env to version control.

# Required: Google Gemini API key (server-side only — never exposed to browser)
GEMINI_API_KEY=your-gemini-api-key-here

# LLM provider: "gemini" (production) or "local" (OpenAI-compatible dev server)
LLM_PROVIDER=gemini
OPENAI_BASE_URL=http://127.0.0.1:8081/openai/v1
OPENAI_API_KEY=sk-gemini
OPENAI_MODEL=

# Optional: Google Maps Places API key (nearest hospital lookup)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Optional: Google Cloud Text-to-Speech (falls back to Web Speech API if unset)
GOOGLE_TTS_CREDENTIALS_PATH=

# Optional: Firebase / Firestore service account path
FIRESTORE_CREDENTIALS_PATH=

# Optional: Firebase project ID
FIRESTORE_PROJECT_ID=

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Frontend
VITE_API_URL=http://localhost:8000
